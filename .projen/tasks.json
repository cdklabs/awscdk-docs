{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "cdk:pin": {
      "name": "cdk:pin",
      "description": "Set a CDK version pin in projenrc/cdk-versions.json",
      "steps": [
        {
          "exec": "tsx src/docgen/pins-cli.ts",
          "receiveArgs": true
        }
      ]
    },
    "check-licenses": {
      "name": "check-licenses",
      "steps": [
        {
          "execArgs": [
            "license-checker",
            "--summary",
            "--onlyAllow",
            "MIT;ISC;Apache-2.0;Python-2.0;0BSD;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;CC0-1.0;CC-BY-4.0;CC-BY-3.0;MPL-2.0",
            "--excludePrivatePackages"
          ],
          "receiveArgs": true
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build"
          ]
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--noEmit",
            "-p",
            "projenrc/tsconfig.json"
          ],
          "name": "typecheck"
        },
        {
          "execArgs": [
            "tsx",
            "--tsconfig",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "docs:a11y": {
      "name": "docs:a11y",
      "description": "Build the e2e fixture site and run the axe-core accessibility audit",
      "steps": [
        {
          "spawn": "docs:generate"
        },
        {
          "exec": "node scripts/e2e-fixture-prune.cjs"
        },
        {
          "exec": "vitepress build docs"
        },
        {
          "exec": "node scripts/agent-markdown-overlay.cjs dist-agent-markdown \"$(node -p \"require('./scripts/site-paths.cjs').distDir()\")\""
        },
        {
          "exec": "playwright test --config test/e2e/playwright.config.ts --grep @a11y",
          "receiveArgs": true
        }
      ]
    },
    "docs:agent-readiness": {
      "name": "docs:agent-readiness",
      "description": "Build the fixture site and run the agent-readiness gate",
      "steps": [
        {
          "spawn": "docs:generate"
        },
        {
          "exec": "node scripts/e2e-fixture-prune.cjs"
        },
        {
          "exec": "vitepress build docs"
        },
        {
          "exec": "node scripts/agent-readiness-run.cjs"
        }
      ]
    },
    "docs:baseline": {
      "name": "docs:baseline",
      "description": "Update the version-history ledger from the installed jsii assemblies",
      "steps": [
        {
          "exec": "tsx src/docgen/cli.ts --update-ledger"
        }
      ]
    },
    "docs:build": {
      "name": "docs:build",
      "description": "Build VitePress site for production",
      "steps": [
        {
          "spawn": "docs:generate"
        },
        {
          "exec": "vitepress build docs"
        }
      ]
    },
    "docs:build:sharded": {
      "name": "docs:build:sharded",
      "description": "Sharded parallel production build on this machine (args: see --help)",
      "steps": [
        {
          "exec": "bash scripts/local-shard-build.sh",
          "receiveArgs": true
        }
      ]
    },
    "docs:dev": {
      "name": "docs:dev",
      "description": "Start VitePress dev server",
      "steps": [
        {
          "spawn": "docs:generate"
        },
        {
          "exec": "vitepress dev docs"
        }
      ]
    },
    "docs:dist:install": {
      "name": "docs:dist:install",
      "description": "Install the documented CDK modules from $CDK_DIST_DIR instead of the registry pins",
      "steps": [
        {
          "exec": "tsx src/docgen/dist-install-cli.ts"
        }
      ]
    },
    "docs:e2e": {
      "name": "docs:e2e",
      "description": "Build the e2e fixture site and run the Playwright browser suite",
      "steps": [
        {
          "spawn": "docs:generate"
        },
        {
          "exec": "node scripts/e2e-fixture-prune.cjs"
        },
        {
          "exec": "vitepress build docs"
        },
        {
          "exec": "node scripts/agent-markdown-overlay.cjs dist-agent-markdown \"$(node -p \"require('./scripts/site-paths.cjs').distDir()\")\""
        },
        {
          "exec": "playwright test --config test/e2e/playwright.config.ts --grep-invert @a11y",
          "receiveArgs": true
        }
      ]
    },
    "docs:generate": {
      "name": "docs:generate",
      "description": "Generate API docs from jsii assemblies",
      "steps": [
        {
          "exec": "tsx src/docgen/cli.ts"
        }
      ]
    },
    "docs:lighthouse": {
      "name": "docs:lighthouse",
      "description": "Build the fixture site and run the Lighthouse performance gate",
      "steps": [
        {
          "spawn": "docs:generate"
        },
        {
          "exec": "node scripts/e2e-fixture-prune.cjs"
        },
        {
          "exec": "vitepress build docs"
        },
        {
          "exec": "node scripts/lighthouse-run.cjs"
        },
        {
          "exec": "node scripts/lighthouse-budget.cjs"
        }
      ]
    },
    "docs:merge": {
      "name": "docs:merge",
      "description": "Merge per-shard dist trees into the built site directory (args: <shardDist...>)",
      "steps": [
        {
          "exec": "node scripts/merge-shards.cjs \"$(node -p \"require('./scripts/site-paths.cjs').distDir()\")\"",
          "receiveArgs": true
        }
      ]
    },
    "docs:preview": {
      "name": "docs:preview",
      "description": "Preview VitePress production build",
      "steps": [
        {
          "exec": "vitepress preview docs"
        }
      ]
    },
    "docs:typecheck": {
      "name": "docs:typecheck",
      "description": "Type-check the VitePress config and theme sources",
      "steps": [
        {
          "exec": "tsc --noEmit -p tsconfig.vitepress.json"
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "test",
            "build-tools",
            "projenrc",
            ".projenrc.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "modules:apply": {
      "name": "modules:apply",
      "description": "Apply the planned module-list sync to docgen.config.json",
      "steps": [
        {
          "exec": "tsx src/docgen/module-sync-cli.ts --apply"
        }
      ]
    },
    "modules:plan": {
      "name": "modules:plan",
      "description": "Diff the documented alpha modules against the aws-cdk release the pins name",
      "steps": [
        {
          "exec": "tsx src/docgen/module-sync-cli.ts --plan"
        }
      ]
    },
    "modules:pr-body": {
      "name": "modules:pr-body",
      "description": "Render the nightly module-list sync PR body from the recorded plan",
      "steps": [
        {
          "exec": "tsx src/docgen/module-sync-cli.ts --pr-body"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "npm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "third-party-licenses"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies",
      "steps": [
        {
          "spawn": "third-party-licenses"
        }
      ]
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "spawn": "check-licenses"
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true",
        "MIN_MAJOR": "1"
      },
      "steps": [
        {
          "exec": "rm -fr dist"
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      },
      "steps": [
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--updateSnapshot"
          ],
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        },
        {
          "spawn": "docs:typecheck"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "third-party-licenses": {
      "name": "third-party-licenses",
      "description": "Regenerate THIRD_PARTY_LICENSES from the production dependency tree",
      "steps": [
        {
          "exec": "tsx src/docgen/cli.ts --third-party-licenses"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0",
        "NPM_CONFIG_BEFORE": "$(node -p \"new Date(Date.now()-259200000).toISOString()\")"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--cooldown=3",
            "--peer",
            "--no-deprecated",
            "--dep=prod",
            "--filter=@vueuse/core,vitepress,vue"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@shikijs/engine-javascript",
            "@vueuse/core",
            "lucide-static",
            "markdown-it-mathjax3",
            "minisearch",
            "shiki",
            "vitepress",
            "vue"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "upgrade-cdklabs-projen-project-types": {
      "name": "upgrade-cdklabs-projen-project-types",
      "description": "upgrade cdklabs-projen-project-types",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=latest",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=cdklabs-projen-project-types,projen"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "cdklabs-projen-project-types",
            "projen"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "upgrade-dev-deps": {
      "name": "upgrade-dev-deps",
      "description": "upgrade dev dependencies",
      "env": {
        "CI": "0",
        "NPM_CONFIG_BEFORE": "$(node -p \"new Date(Date.now()-259200000).toISOString()\")"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--cooldown=3",
            "--peer",
            "--no-deprecated",
            "--dep=dev",
            "--filter=@axe-core/playwright,@jsii/spec,@playwright/test,@types/jest,@types/node,eslint-import-resolver-typescript,eslint-plugin-import,jest,license-checker,ts-jest,tsx,typescript"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@axe-core/playwright",
            "@jest/globals",
            "@jsii/spec",
            "@playwright/test",
            "@stylistic/eslint-plugin",
            "@types/jest",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "botvisibility",
            "commit-and-tag-version",
            "constructs",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "htmlparser2",
            "jest",
            "jest-junit",
            "license-checker",
            "lighthouse",
            "ts-jest",
            "tsx",
            "typescript"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "versions:apply": {
      "name": "versions:apply",
      "description": "Apply the planned version refresh to the pins and the committed snapshot",
      "steps": [
        {
          "exec": "tsx src/docgen/version-refresh-cli.ts --apply"
        }
      ]
    },
    "versions:plan": {
      "name": "versions:plan",
      "description": "Resolve released CDK versions and record what the nightly refresh would change",
      "steps": [
        {
          "exec": "tsx src/docgen/version-refresh-cli.ts --plan"
        }
      ]
    },
    "versions:pr-body": {
      "name": "versions:pr-body",
      "description": "Render the nightly version refresh PR body from the recorded plan",
      "steps": [
        {
          "exec": "tsx src/docgen/version-refresh-cli.ts --pr-body"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build",
            "-w"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
